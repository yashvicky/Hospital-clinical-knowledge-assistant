# Qdrant vector database (replaces PostgreSQL + pgvector)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=clinical_sops

# Self-hosted Text Embeddings Inference (TEI) service running BGE-M3.
# No API key needed -- runs entirely inside the hospital network.
TEI_EMBEDDING_URL=http://localhost:8080

# Self-hosted vLLM server exposing an OpenAI-compatible API for Llama 3.
# No API key needed by default; set VLLM_API_KEY only if you've configured
# vLLM with its own auth token.
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL_NAME=meta-llama/Meta-Llama-3-8B-Instruct
VLLM_API_KEY=

# Dimensionality used by qdrant_init.py when creating the collection.
# BGE-M3 dense output is 1024-dimensional.
EMBEDDING_DIM=1024
